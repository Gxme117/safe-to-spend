{
  "expo": {
    "name": "Money tracker",
    "slug": "money-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gxme1170.money-tracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Pinch turns what you say into text on your phone. It doesn't send your voice anywhere.",
        "NSMicrophoneUsageDescription": "Pinch uses the microphone so you can say your question to Tim and Frank instead of typing it."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Pinch uses the microphone so you can say your question to Tim and Frank instead of typing it.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Pinch uses the microphone so you can say your question to Tim and Frank instead of typing it."
        }
      ]
    ],
    "scheme": "moneytracker",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "40fd5790-8238-4a21-a22a-8236c04461e9"
      }
    },
    "owner": "gxme1170"
  }
}
