{
  "expo": {
    "name": "Money tracker",
    "slug": "money-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gxme1170.money-tracker",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Pinch turns what you say into text on your phone. It doesn't send your voice anywhere."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Pinch uses the microphone so you can say your question to Tim and Frank instead of typing it.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Pinch uses the microphone so you can say your question to Tim and Frank instead of typing it."
        }
      ]
    ],
    "scheme": "moneytracker"
  }
}
