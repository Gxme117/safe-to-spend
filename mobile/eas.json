{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "tester",
        "EXPO_PUBLIC_LINKS": "off"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "tester",
        "EXPO_PUBLIC_LINKS": "off"
      },
      "ios": {
        "distribution": "store"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "com.gxme.pinch",
        "appName": "Pinch: Safe to Spend"
      }
    }
  }
}
